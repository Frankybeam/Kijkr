 namespace hui::ui
 {
 
+// An app can put its own words in another language: every line text() draws
+// and measure() measures goes through this filter first. It returns the text
+// to use, which must stay valid until the next frame (or the input itself).
+#define HUI_HAS_TEXT_FILTER 1
+using TextFilter = std::string_view (*)(std::string_view);
+inline TextFilter &text_filter()
+{
+    static TextFilter filter = nullptr;
+    return filter;
+}
+inline std::string_view filtered(std::string_view value)
+{
+    const TextFilter filter = text_filter();
+    return filter ? filter(value) : value;
+}
+
 // A loaded font and the GL texture holding its atlas.
 struct FontRef
 {
@@ -23,7 +39,7 @@ struct FontRef
 
